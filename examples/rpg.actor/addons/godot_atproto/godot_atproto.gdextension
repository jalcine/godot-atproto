[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../../extension/target/debug/libgodot_atproto.so"
linux.release.x86_64 = "res://../../extension/target/release/libgodot_atproto.so"
windows.debug.x86_64 = "res://../../extension/target/debug/godot_atproto.dll"
windows.release.x86_64 = "res://../../extension/target/release/godot_atproto.dll"
macos.debug = "res://../../extension/target/debug/libgodot_atproto.dylib"
macos.release = "res://../../extension/target/release/libgodot_atproto.dylib"
macos.debug.arm64 = "res://../../extension/target/debug/libgodot_atproto.dylib"
macos.release.arm64 = "res://../../extension/target/release/libgodot_atproto.dylib"
